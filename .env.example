# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Keystore settings (for Codemagic use secrets or the Signing feature)
STORE_PASSWORD=
KEY_PASSWORD=
KEYSTORE_PATH=./my-upload-key.jks  # local path example; on CI use uploaded keystore reference or absolute path
KEY_ALIAS=upload

# Optional: Package name
PACKAGE_NAME=com.aistudio.gnzmon.wqrk

